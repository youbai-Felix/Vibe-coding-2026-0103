{
  "manifest_version": 3,
  "name": "侧栏隐藏（知识星球/小报童）",
  "version": "1.1.1",
  "description": "隐藏知识星球左/右侧栏与小报童右侧专栏信息栏，正文更宽。点工具栏图标 / Alt+Shift+Z（左栏）/ Alt+Shift+X（右栏）/ 页面左右缘悬浮箭头均可切换。",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.zsxq.com/*", "https://xiaobot.net/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "隐藏/显示侧栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "显示/隐藏知识星球左侧栏"
    },
    "toggle-right": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "显示/隐藏右侧栏（知识星球/小报童）"
    }
  }
}
